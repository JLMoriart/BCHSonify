# BCHSonify's site (installed by deploy_web.sh, which fills in {SITE}): the visitors' pages and their files,
# the relay's live feed at /ws, and the music shop (server/shop.py, in the relay): its API at /shop/, and the
# paid .wav files at /dl/<order>/<key>/<track>.wav, each download allowed only after asking the shop.
# Caddy gets and renews the https certificate itself. Other addresses for the site (BCHSONIFY_REDIRECTS: www, an
# old domain) are added by deploy_web.sh after this, each redirecting to the same page here.
{SITE} {
	encode zstd gzip
	# check back on every visit (cheap: unchanged files answer "not modified"), so a deploy shows up at once
	header Cache-Control "no-cache"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin

	handle /ws {
		reverse_proxy 127.0.0.1:8765
	}
	handle /shop/* {
		reverse_proxy 127.0.0.1:8766
	}
	handle /dl/* {
		route {
			forward_auth 127.0.0.1:8766 {
				uri /shop/auth
			}
			uri path_regexp ^/dl/[^/]+/[^/]+/([a-z0-9-]+\.wav)$ /$1
			root * /var/lib/bchsonify-wav
			header Content-Disposition attachment
			header Cache-Control "private, no-store"
			file_server
		}
	}
	handle {
		root * /var/www/bchsonify
		file_server
	}
}
